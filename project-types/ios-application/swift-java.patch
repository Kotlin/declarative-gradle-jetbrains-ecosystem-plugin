+{
+    "javaPackage": "com.apple.xcode.project.format",
+    "mode": "jni",
+    "memoryManagementMode": "allowGlobalAutomatic",
+    "swiftFilterInclude": ["Schema/**", "CollectionUtils.swift"],
+    "swiftFilterExclude": ["Comparable"],
+    "overrideStaticBlockLibraryLoading": [
+        "SwiftLibraries.loadLibraryWithFallbacks(SwiftLibraries.LIB_NAME_SWIFT_JAVA);",
+        "SwiftLibraries.loadLibraryWithFallbacks(\"SwiftRuntimeFunctions\");",
+        "SwiftLibraries.loadLibraryWithFallbacks(LIB_NAME);",
+    ]
+}
