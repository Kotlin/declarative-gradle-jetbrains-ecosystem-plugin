// examples/spring-petklinik/shared, with per-platform dependencies and tests in the platform blocks.
library {
  platforms [:jvm, :web]

  dependencies {
    implementation [
      "org.jetbrains.kotlinx:kotlinx-html:0.12.0",
      "io.konform:konform:0.11.1",
    ]
  }

  testing {
    dependencies {
      implementation ["org.jetbrains.kotlin:kotlin-test"]
    }
  }

  jvmPlatform {
    testing {
      dependencies {
        implementation ["org.jetbrains.kotlin:kotlin-test-junit"]
      }
    }
  }

  webPlatform {
    dependencies {
      implementation ["org.jetbrains.kotlinx:kotlinx-browser:0.5.0"]
    }
    testing {
      skip true
      dependencies {
        implementation ["org.jetbrains.kotlinx:kotlinx-browser:0.5.0"]
      }
    }
  }
}
