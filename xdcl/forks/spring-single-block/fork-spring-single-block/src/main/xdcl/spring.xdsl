// Spring support. Mocked: Spring would ship this schema in its own plugin, contributing to the JetBrains ecosystem
// through the extension points (traits) it exposes. It lives in its own package so that move is just a file move.
package org.jetbrains.ecosystem.forks.springsingleblock.spring

import org.jetbrains.ecosystem.forks.springsingleblock

/// Enables Spring Boot: applies the `org.springframework.boot` plugin and adds the Spring Boot BOM.
///
/// Fork: everything Spring-specific lives in this one block, instead of separate `spring { }` blocks in
/// `dependencies` and `packaging` that only work together with this one.
extension Spring for JvmApplicationFeatures {
  spring {
    /// Dependencies used only during development, e.g. `"org.springframework.boot:spring-boot-docker-compose"`.
    developmentOnly: [Dependency]?
    /// Configures the `bootBuildImage` task.
    bootBuildImage: BootBuildImage?
  }
}

record BootBuildImage {
  /// Environment variables of the image build, e.g. `[BP_JVM_CDS_ENABLED: "true"]`.
  environment: [String: String]?
}
