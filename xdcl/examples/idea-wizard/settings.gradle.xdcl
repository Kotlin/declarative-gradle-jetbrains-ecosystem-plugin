// Port of examples/idea-wizard: the multi-module project generated by the IntelliJ IDEA wizard.
settings {
  rootProject {
    name "idea-wizard"
  }
  pluginManagement {
    includedBuilds ["../../ecosystem"]
  }
  plugins [
    // Downloads the JDKs required by the toolchains.
    { id "org.gradle.toolchains.foojay-resolver-convention", version "1.0.0" }
    { id "org.jetbrains.ecosystem" }
  ]
  dependencyResolutionManagement {
    repositories [:mavenCentral]
  }
  defaults [
    jvmApplication {
      toolchain {
        releaseVersion 17
      }
      testing {
        useJUnitPlatform true
      }
    }
    library {
      jvmPlatform {
        toolchain {
          releaseVersion 17
        }
      }
      testing {
        jvmPlatform {
          useJUnitPlatform true
        }
      }
    }
  ]
  include ["app", "utils"]
}
