// Port of examples/spring-petklinik. Build-wide policy lives in `defaults` (it never switches a feature on); a kind of
// project lives in a prefab, which a project opts into by name.
settings {
  rootProject {
    name "Spring-PetKlinik"
  }
  pluginManagement {
    includedBuilds ["../../ecosystem"]
  }
  plugins [
    { id "org.gradle.toolchains.foojay-resolver-convention", version "1.0.0" }
    { id "org.jetbrains.ecosystem" }
  ]
  dependencyResolutionManagement {
    repositories [:mavenCentral]
  }
  defaults [
    jvmApplication {
      toolchain {
        releaseVersion 17
      }
      testing {
        useJUnitPlatform true
      }
    }
    library {
      platforms [:jvm, :web]
      jvmPlatform {
        toolchain {
          releaseVersion 17
        }
      }
      webPlatform {
        subplatforms [:wasmJs]
      }
    }
    // Wherever a project enables serialization, it uses JSON.
    serialization {
      enabledFormats [:json]
    }
  ]
  prefabs [
    /// A Spring Boot application.
    ///
    /// Candidate to be shipped by the Spring plugin instead of being defined here.
    springBootApp: jvmApplication {
      spring { }
      packaging {
        spring {
          bootBuildImage {
            environment [
              BP_JVM_CDS_ENABLED: "true",
              BP_JVM_VERSION: "25",
            ]
          }
        }
      }
      // `append`: a project's own `implementation [...]` adds to these instead of replacing them.
      dependencies {
        implementation { append ["org.jetbrains.kotlin:kotlin-reflect"] }
      }
      testing {
        dependencies {
          implementation {
            append [
              "org.springframework.boot:spring-boot-starter-test",
              "org.jetbrains.kotlin:kotlin-test-junit5",
            ]
          }
          runtimeOnly { append ["org.junit.platform:junit-platform-launcher"] }
        }
      }
    }
  ]
  include ["frontend", "backend", "shared", "ai"]
}
