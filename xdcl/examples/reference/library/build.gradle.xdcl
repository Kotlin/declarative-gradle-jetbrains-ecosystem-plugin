library {
  platforms [:common, :jvm, :web, :ios, :android]

  kotlin {
    compilerOptions {
      freeCompilerArgs ["-Xcollection-literals"]
    }

    serialization {
      enabledFormats [:json]
    }
  }

  java {
    compilerOptions {
      compilerArgs ["-Xlint:deprecation", "-Xlint:unchecked"]
    }
  }

  jvmPlatform {
    toolchain {
      releaseVersion 21
      vendor :adoptium
      nativeImageCapable false
    }

    kotlin {
      compilerOptions {
        jvmTarget 21
      }
    }
  }

  webPlatform {
    subplatforms [:js, :wasmJs]

    kotlin {
      compilerOptions {
        sourceMap true
      }
    }
  }

  iosPlatform {
    subplatforms [:iosArm64, :iosSimulatorArm64, :iosX64]

    kotlin {
      compilerOptions {
        moduleName "library"
      }
    }
  }

  androidPlatform {
    minSdk 21
    compileSdk 37
    namespace "com.example.library"

    kotlin {
      compilerOptions {
        jvmTarget 21
        freeCompilerArgs ["-Xexport-kdoc", "-Xno-receiver-assertions"]
      }
    }
  }

  dependencies {
    api [:projects.shared]
    implementation ["org.jetbrains.kotlinx:kotlinx-html:0.12.0"]

    jvmPlatform {
      api ["org.jetbrains.kotlinx:kotlinx-serialization-core:1.9.0"]
      implementation ["org.jetbrains.kotlin:kotlin-reflect"]
      compileOnly ["org.jspecify:jspecify:1.0.0"]
      runtimeOnly ["ch.qos.logback:logback-classic:1.5.18"]
    }

    webPlatform {
      implementation [
        "org.jetbrains.kotlinx:kotlinx-browser:0.5.0",
        { npm "@js-joda/timezone", version "2.3.0" },
      ]
    }

    iosPlatform {
      implementation ["org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2"]
    }

    androidPlatform {
      implementation ["androidx.core:core-ktx:1.17.0"]
      debugImplementation ["androidx.compose.ui:ui-tooling:1.9.0"]
    }
  }

  testing {
    jvmPlatform {
      useJUnitPlatform true
    }

    webPlatform {
      skip true
    }

    dependencies {
      implementation ["org.jetbrains.kotlin:kotlin-test"]

      jvmPlatform {
        implementation [
          "org.junit.jupiter:junit-jupiter:5.12.2",
          { testFixtures :projects.shared },
        ]
        compileOnly ["org.jetbrains:annotations:26.0.2"]
        runtimeOnly ["org.junit.platform:junit-platform-launcher:1.12.2"]
      }

      webPlatform {
        implementation ["org.jetbrains.kotlinx:kotlinx-browser:0.5.0"]
      }

      iosPlatform {
        implementation ["org.jetbrains.kotlin:kotlin-test"]
      }
    }
  }

  publishing {
    group "com.example"
    version "1.0.0"

    maven {
      name "library"
      repositoryUrl "file:///tmp"
      withDocs true
      withSources true
    }

    iosFramework {
      static true
      linkerOpts ["-lld"]
      export [:libs.some.library]
      transitiveExport true
    }
  }
}
