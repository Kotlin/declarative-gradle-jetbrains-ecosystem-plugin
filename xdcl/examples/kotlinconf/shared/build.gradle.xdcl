library { // nonAndroidMain custom shared source set is not covered
  kotlin {
    serialization { }
    parcelize { }
    compilerOptions {
      freeCompilerArgs ["-Xexpect-actual-classes"]
    }
  }

  compose { }

  aboutLibraries {
    library {
      duplicationMode :merge
      duplicationRule :simple
    }
    export {
      outputFile "src/commonMain/composeResources/files"
    }
  }

  androidPlatform {
    namespace "org.jetbrains.kotlinconf"

    kotlin {
      compilerOptions {
        freeCompilerArgs [
          "-P",
          "plugin:org.jetbrains.kotlin.parcelize:additionalAnnotation=org.jetbrains.kotlinconf.zoomable.internal.AndroidParcelize",
        ]
      }
    }
  }

  publishing {
    iosFramework {
      baseName "shared"
      static true
    }
  }

  dependencies {
    api [
      :projects.core,
      :projects.uiComponents,

      :libs.compose.runtime,
      :libs.compose.foundation,
      :libs.compose.animation,
      :libs.compose.components.resources,

      :libs.koin.compose.viewmodel.navigation,

      :libs.ktor.client.logging,
      :libs.ktor.serialization.kotlinx.json,
      :libs.ktor.client.content.negotiation,
      :libs.ktor.utils,

      :libs.kmpnotifier,
    ]
    implementation [
      :libs.kotlinx.datetime,

      :libs.androidx.lifecycle.runtime.compose,
      :libs.androidx.navigation3.ui,
      :libs.androidx.lifecycle.viewmodel.navigation3,
      :libs.ktor.client.core,

      :libs.aboutlibraries.core,

      // Multiplatform Settings
      :libs.settings,
      :libs.settings.serialization,
      :libs.settings.observable,
      :libs.settings.coroutines,

      :libs.doistx.normalize,
    ]

    iosPlatform {
      implementation [:libs.kotlinx.coroutines.core, :libs.ktor.client.darwin]
    }

    androidPlatform {
      implementation [
        :libs.android.svg,
        :libs.androidx.core.ktx,
        :libs.androidx.preference,
        :libs.compose.ui.tooling.preview,
        :libs.ktor.client.okhttp,
      ]
      debugImplementation [:libs.compose.ui.tooling]
    }

    jvmPlatform {
      implementation [
        :libs.ktor.client.okhttp,
        :compose.desktop.currentOs,
        :libs.android.svg,
        :libs.kotlinx.coroutines.swing,
        :libs.slf4j.nop,
      ]
    }

    webPlatform {
      implementation [
        :libs.ktor.client.js,
        { npm "@js-joda/timezone", version "2.3.0" },
      ]
    }
  }

  testing {
    dependencies {
      implementation [:libs.kotlin.test, :libs.settings.test, :libs.kotlinx.coroutines.test]
    }
  }
}
