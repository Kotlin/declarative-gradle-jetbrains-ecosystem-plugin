// The KotlinConf app from the wireframes (docs/[Prototype wireframes] …, "Kotlinconf App" tab). Design only: the
// Android, Ktor and AboutLibraries plugins are schema-only mocks (xdcl/mocks/).
// Build-wide policy lives in `defaults` (it never switches a feature on); a kind of project lives in a prefab, which a
// project opts into by name.
settings {
  rootProject {
    name "KotlinConfApp"
  }
  pluginManagement {
    // Google's Maven repository is a plain URL: settings repositories have no `google()` and no content filters.
    repositories ["https://dl.google.com/dl/android/maven2/", :gradlePluginPortal, :mavenCentral]
    includedBuilds [
      "../../ecosystem",
      "../../mocks/android-ecosystem",
      "../../mocks/ktor-ecosystem",
      "../../mocks/aboutlibraries",
    ]
  }
  plugins [
    { id "org.jetbrains.ecosystem" }
    { id "com.android.ecosystem" }
    { id "org.jetbrains.ktor.ecosystem" }
    { id "com.mikepenz.aboutlibraries" }
  ]
  dependencyResolutionManagement {
    repositories ["https://dl.google.com/dl/android/maven2/", :mavenCentral]
  }
  defaults [
    library {
      platforms [:android, :jvm, :ios, :web]

      jvmPlatform {
        toolchain {
          releaseVersion 21
        }
      }

      androidPlatform {
        // Was `libs.versions.android.compileSdk`: an Int property can't reference the version catalog.
        compileSdk 36
        minSdk 24
        kotlin {
          compilerOptions {
            jvmTarget 11
          }
        }
      }
    }

    // Defaults for an optional block: configures Compose wherever a project enables it, enables it nowhere.
    compose {
      resources {
        packageOfResClass "org.jetbrains.kotlinconf.generated.resources"
      }
    }
  ]
  prefabs [
    /// A Ktor server running on Netty, packaged as a container image with Jib.
    ///
    /// Candidate to be shipped by the Ktor plugin instead of being defined here.
    ktorServer: jvmApplication {
      mainClass "io.ktor.server.netty.EngineMain"
      ktor { }
      packaging {
        jib {
          container {
            mainClass "io.ktor.server.netty.EngineMain"
          }
        }
      }
      testing {
        useJUnitPlatform true
      }
    }

    /// A Compose Multiplatform desktop application.
    ///
    /// Candidate to be shipped by the JetBrains ecosystem plugin instead of being defined here.
    composeDesktopApp: jvmApplication {
      compose { }
      // `append`: a project's own `implementation [...]` adds to this instead of replacing it.
      dependencies {
        implementation { append [:compose.desktop.currentOs] }
      }
    }
  ]
  include ["androidApp", "desktopApp", "backend", "webApp", "ui-components", "shared", "core"]
}
